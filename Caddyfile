{
	auto_https off
	admin off
}

# Railway porti $PORT orqali beriladi
:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	# Admin panel — login va parol bilan yopiq (parol: Railway Variables → ADMIN_PASSWORD)
	@admin path /boshqaruv-k7x2.html /js/admin.js /css/admin.css
	basic_auth @admin {
		{$ADMIN_USER:admin} {$ADMIN_HASH}
	}

	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	# Sahifa, kod va ma'lumotlar har safar tekshirilsin (yangilanish darrov ko'rinsin);
	# faqat og'ir rasm va kutubxonalar uzoq saqlansin
	header Cache-Control "no-cache"
	@static path /images/* /js/vendor/*
	header @static Cache-Control "public, max-age=2592000"

	# Serverga kerak bo'lmagan fayllar tashqariga chiqmasin
	@private path /worker/* /Dockerfile /Caddyfile /start.sh /.dockerignore /README.md
	respond @private 404
}
