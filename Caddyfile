{
	auto_https off
	admin off
}

# Railway porti $PORT orqali beriladi
:{$PORT:8080} {
	root * /srv
	encode gzip zstd
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	# Rasm va kutubxonalar uzoq saqlansin, sahifa va ma'lumotlar har safar yangilansin
	@static path /images/* /js/vendor/*
	header @static Cache-Control "public, max-age=2592000"
	@fresh path / /index.html /js/data.js /js/app.js /js/world.js /js/track.js /js/texts.js /css/*
	header @fresh Cache-Control "no-cache"

	# Serverga kerak bo'lmagan fayllar tashqariga chiqmasin
	@private path /worker/* /Dockerfile /Caddyfile /.dockerignore /README.md
	respond @private 404
}
